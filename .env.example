# ─── LOCAL DEV (no API keys needed) ─────────────────────────────────────────
# Default: ChromaDB local vector store + Ollama LLM/embeddings

# Set to 'pinecone' to use Pinecone cloud vector store instead
VECTORSTORE_BACKEND=chroma_local

# Local ChromaDB storage path
CHROMA_PERSIST_DIR=.chroma_db

# ─── OLLAMA (local, free) ─────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── PRODUCTION (optional, set when deploying) ───────────────────────────────
# Set CI=true in GitHub Actions to use OpenAI embeddings + GPT-4o
# CI=true

# OpenAI (used on CI for embeddings, optional for local)
# OPENAI_API_KEY=sk-...

# Pinecone (optional — needed only when VECTORSTORE_BACKEND=pinecone)
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=docbot-docs

# ─── SLACK BOT ───────────────────────────────────────────────────────────────
# Get these from https://api.slack.com/apps after creating your Slack app
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# ─── LANGSMITH (optional, free tier) ─────────────────────────────────────────
# Sign up at https://smith.langchain.com — free tier: 10k traces/month
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_...
# LANGCHAIN_PROJECT=docbot
